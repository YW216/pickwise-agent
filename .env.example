# ============ 必填 ============
# 主模型 API Key（OpenAI 兼容协议）。获取后填入，勿提交本文件。
OPENAI_API_KEY=sk-your-key-here

# ============ 主模型配置 ============
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash
TEMPERATURE=0.7

# HTTP 阶段超时，不是整次请求 deadline；2 次重试 = 最多 3 次尝试。
# 主聊天、Embedding、评测脚本均使用这套配置。
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=2

# 思考强度（DeepSeek 思考模式）：low / high / max，空 = 不传
# 仅作用于子 Agent 与 Result；Router 固定 low + max_tokens=2048
REASONING_EFFORT=high

# ============ Embedding（第5期 RAG） ============
# Embedding 服务独立配置。留空时回退到上面的 OPENAI_BASE_URL / OPENAI_API_KEY。
# ⚠️ 回退仅在主模型 provider 确实提供 embedding 端点时成立：
#    OpenAI 官方可以；DeepSeek 官方不提供（实测 404），所以走 DeepSeek 时
#    下面两项必须显式配置，否则启动前就会被 assert_embedding_configured 拦下。
# 示例：硅基流动 SiliconFlow（国内直连，OpenAI 兼容）
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=sk-your-siliconflow-key
EMBEDDING_MODEL=BAAI/bge-m3

# 向量库：standalone（deploy/milvus 下 docker compose 启动）
MILVUS_URI=http://localhost:19530

# ============ 记忆（第7期） ============
MEMORY_ENABLED=true
MEMORY_DIR=app/sessions/memory
MEMORY_USER_ID=default
MAX_LTM_FACTS=50

# ============ Skill（第8期） ============
SKILLS_ENABLED=true
SKILLS_DIR=app/agent/skills/definitions

# ============ 真值层数据库（PostgreSQL，可选） ============
# 空串 = 未落库，商品目录回退本地 JSON 数据文件
# DATABASE_URL=postgresql://user:password@localhost:15432/pickwise

# ============ 可观测性（Langfuse，可选） ============
# 不配置则全链路 no-op，不影响运行
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_SECRET_KEY=sk-lf-xxx

# ============ 上下文压缩 ============
CONTEXT_WINDOW=200000
RESERVE_TOKENS=32768
KEEP_RECENT_TOKENS=8000

# ============ 评测（第9期，离线评估工具） ============
EVAL_DATASET_PATH=app/evaluation/cases.json
EVAL_USE_JUDGE=true
EVAL_PASS_THRESHOLD=0.6

# ---------------------------------------------------------------------------
# 关于 MCP：本项目 ToolManager 的 MCP 分支尚未实现，配置后会降级使用本地工具，
# 故默认注释掉。MCP_ENABLED=false
# MCP_SERVER_URL=http://127.0.0.1:9123/mcp
#
# ⚠️ 不要添加本文件未列出的键：pydantic-settings 默认 extra_forbidden，
#    未声明的键会让整个 Settings 加载失败。
# ---------------------------------------------------------------------------
